{
  "listen": "127.0.0.1:18083",
  "responses_listen": "127.0.0.1:18084",
  "upstream": "http://127.0.0.1:9099/ok",
  "max_retries": 3,
  "base_delay_s": 0.2,
  "max_delay_s": 2,
  "total_budget_s": 10,
  "retry_status_codes": [429, 500, 502, 503, 504],
  "respect_retry_after": false,
  "log_request_detail": false,
  "recent_sample_window": 20,
  "vars": { "SMOKE_KEY": "smoke" },
  "classifier_route": { "url": "http://127.0.0.1:9099/think", "classifier_thinking_cc": "off", "classifier_thinking_codex": "low" },
  "search_fallback": { "url": "http://127.0.0.1:9099/search", "api": "$SMOKE_KEY", "model": "searchmodel", "claudeSearchThinking": "low", "claudeSearchSummary": "forceMid" },
  "routes": [
    { "pattern": ["smoke-sf", "smoke-sf-alt"], "url": "http://127.0.0.1:9099/ok", "api": "smoke", "no_search": true, "claudeSearchSummary": "forceHigh" },
    { "pattern": "smoke-enh", "url": "http://127.0.0.1:9099/search", "api": "smoke", "enhance_search": { "summary_level": "high", "summary_thinking": true } }
  ]
}
